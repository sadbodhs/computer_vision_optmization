# Model binaries — GPU/driver-specific, regenerate with scripts/export_models.sh
*.plan
*.engine
*.onnx
*.pt
# INT8 calibration cache — locked to the TensorRT build that produced it
*.cache

# Preprocessed capacity-replay input — regenerate with scripts/make_frames.sh
*.bin

# Videos (any source video; the benchmarks use videos/real.mp4)
videos/

# Local export scratch dirs created by scripts/export_models.sh
_exp_fixed/
_exp_dyn/

# Misc
__pycache__/
*.pyc
core

# MkDocs build output (site is generated, never committed)
site_src/
_site/
site/

# Export scratch. torch writes ONNX external weights as EXTENSIONLESS files
# (e.g. e.layers.0.attn.qkv.bias) once a model exceeds the 2 GB protobuf limit,
# so the *.onnx rule above does not catch them - SAM ViT-H alone left 6.8 GB of
# them here and they staged cleanly into a commit. Ignore the whole directory.
triton/models/_exp/
triton/models/*.tsv
