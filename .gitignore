# Model binaries — GPU/driver-specific, regenerate with scripts/export_models.sh
*.plan
*.engine
*.onnx
*.pt
# INT8 calibration cache — locked to the TensorRT build that produced it
*.cache

# Preprocessed capacity-replay input — regenerate with scripts/make_frames.sh
*.bin

# Videos (any source video; the benchmarks use videos/real.mp4)
videos/

# Local export scratch dirs created by scripts/export_models.sh
_exp_fixed/
_exp_dyn/

# Misc
__pycache__/
*.pyc
core

# MkDocs build output (site is generated, never committed)
site_src/
_site/
site/
